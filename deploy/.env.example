# =============================================================================
# Konfigurasi Lingkungan Produksi (VPS)
# Salin file ini menjadi .env di dalam folder deploy/: cp .env.example .env
# =============================================================================

# Domain publik ATAU IP Publik VPS
# Contoh jika tanpa domain: DOMAIN=103.123.45.67
# Contoh jika dengan domain: DOMAIN=iot.domainkamu.com
DOMAIN=103.123.45.67

# Keamanan Cookie Login
# Set false jika menggunakan IP VPS / HTTP biasa (tanpa SSL) agar browser dapat menyimpan cookie
# Set true jika sudah menggunakan domain dengan SSL HTTPS
COOKIE_SECURE=false

# Kredensial Database PostgreSQL
POSTGRES_USER=iot_admin
POSTGRES_PASSWORD=GantiDenganPasswordDatabaseYangKuat123!
POSTGRES_DB=iot_supercap

# Kunci Rahasia JWT (Minimal 32 karakter acak untuk enkripsi sesi login)
# Buat dengan: openssl rand -hex 32
JWT_SECRET=f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8

# Akun Login Administrator Dashboard Web
ADMIN_EMAIL=admin@domainkamu.com
ADMIN_PASSWORD=GantiDenganPasswordAdminYangKuat123!

# Kunci Perangkat ESP32 (Wajib sama dengan yang ter-flash di firmware ESP32)
# Nilai di bawah ini adalah kunci aktif yang saat ini ada di secrets.h ESP32
DEVICE_KEY=64e4a398d94d4e417493211ae4d87d3389bde95d57532d0459c113233cae61e3
